<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <t t-name="toko_sentosa_pos_custom.HazardousItemPopup">
        <!--
            Overlay gelap + modal peringatan hazardous item.
            Enhanced: backdrop blur, checkbox konfirmasi, fade-in animation.
            OWL 2 (Odoo 17+/19): akses getter langsung tanpa prefix "component."
        -->
        <div class="modal-overlay hazardous-overlay"
             style="
                position: fixed; inset: 0;
                background: rgba(0,0,0,0.55);
                backdrop-filter: blur(4px);
                -webkit-backdrop-filter: blur(4px);
                z-index: 9999;
                display: flex; align-items: center; justify-content: center;
                animation: fadeInOverlay 0.25s ease;
             ">

            <div class="hazardous-modal"
                 t-attf-style="
                    background: {{ hazardConfig.bg }};
                    border-radius: 16px;
                    box-shadow: 0 20px 60px rgba(0,0,0,0.35);
                    width: 440px; max-width: 95vw;
                    padding: 0;
                    overflow: hidden;
                    animation: slideUp 0.3s ease;
                    border-left: 5px solid {{ hazardConfig.color }};
                 ">

                <!-- ── Header ── -->
                <div class="hazardous-header"
                     t-attf-style="
                        background: {{ hazardConfig.color }};
                        padding: 20px 24px 16px;
                        text-align: center;
                        color: white;
                     ">
                    <div style="font-size: 48px; margin-bottom: 8px;">
                        <i t-attf-class="fa {{ hazardConfig.icon }}"/>
                    </div>
                    <div style="font-size: 13px; font-weight: 600; letter-spacing: 1px; opacity: 0.9; text-transform: uppercase;">
                        ⚠️ PRODUK MEMERLUKAN PENANGANAN KHUSUS
                    </div>
                </div>

                <!-- ── Body ── -->
                <div style="padding: 24px 24px 20px;">

                    <!-- Nama produk -->
                    <div style="text-align: center; margin-bottom: 16px;">
                        <div style="font-size: 11px; color: #888; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px;">
                            Produk
                        </div>
                        <div style="font-size: 18px; font-weight: 700; color: #2c3e50;">
                            <t t-esc="props.product.display_name"/>
                        </div>
                    </div>

                    <!-- Badge jenis bahaya -->
                    <div style="text-align: center; margin-bottom: 16px;">
                        <span t-attf-style="
                            display: inline-block;
                            background: {{ hazardConfig.color }};
                            color: white;
                            border-radius: 20px;
                            padding: 5px 16px;
                            font-size: 12px;
                            font-weight: 600;
                        ">
                            <i t-attf-class="fa {{ hazardConfig.icon }} me-1"/>
                            <t t-esc="hazardLabel"/>
                        </span>
                    </div>

                    <!-- Garis pemisah -->
                    <hr t-attf-style="border-color: {{ hazardConfig.color }}; opacity: 0.3; margin: 0 0 14px;"/>

                    <!-- Instruksi standar berdasarkan jenis bahaya -->
                    <div style="font-size: 13px; color: #555; margin-bottom: 12px; line-height: 1.6;">
                        <t t-if="props.product.x_hazard_type === 'chemical'">
                            <strong style="color: #e67e22;">🧪 Penanganan Zat Kimia:</strong><br/>
                            • Hindari kontak langsung dengan kulit / mata<br/>
                            • Pastikan pembeli memahami cara penyimpanan<br/>
                            • Kemas terpisah dari bahan makanan
                        </t>
                        <t t-elif="props.product.x_hazard_type === 'sharp'">
                            <strong style="color: #e74c3c;">🔪 Penanganan Benda Tajam:</strong><br/>
                            • Verifikasi usia pembeli jika diperlukan<br/>
                            • Pastikan dikemas dengan pelindung aman<br/>
                            • Ingatkan pembeli untuk menyimpan di tempat aman
                        </t>
                        <t t-elif="props.product.x_hazard_type === 'flammable'">
                            <strong style="color: #c0392b;">🔥 Penanganan Bahan Mudah Terbakar:</strong><br/>
                            • Jauhkan dari sumber api / panas<br/>
                            • Simpan di tempat berventilasi baik<br/>
                            • Kemas dalam kantong terpisah
                        </t>
                        <t t-else="">
                            <strong style="color: #f39c12;">⚠️ Perhatian Khusus:</strong><br/>
                            • Produk ini memerlukan penanganan ekstra hati-hati<br/>
                            • Ikuti prosedur standar penanganan barang berbahaya
                        </t>
                    </div>

                    <!-- Catatan kustom dari admin (jika ada) -->
                    <t t-if="hazardNotes">
                        <div t-attf-style="
                            background: white;
                            border-left: 4px solid {{ hazardConfig.color }};
                            border-radius: 0 8px 8px 0;
                            padding: 10px 14px;
                            font-size: 12px;
                            color: #444;
                            margin-bottom: 12px;
                            line-height: 1.5;
                        ">
                            <strong>📋 Catatan Admin:</strong><br/>
                            <t t-esc="hazardNotes"/>
                        </div>
                    </t>

                    <!-- ── Checkbox Konfirmasi Kasir (WAJIB) ── -->
                    <div class="hazardous-confirm-section"
                         t-attf-style="
                            background: {{ state.confirmed ? '#d4edda' : '#fff3cd' }};
                            border: 1px solid {{ state.confirmed ? '#28a745' : '#ffc107' }};
                            border-radius: 10px;
                            padding: 12px 14px;
                            font-size: 13px;
                            color: {{ state.confirmed ? '#155724' : '#856404' }};
                            margin-bottom: 0;
                            cursor: pointer;
                            transition: all 0.3s ease;
                         "
                         t-on-click="toggleConfirm">
                        <label style="display: flex; align-items: center; gap: 10px; cursor: pointer; margin: 0;">
                            <input type="checkbox"
                                   class="hazardous-checkbox"
                                   t-att-checked="state.confirmed"
                                   t-on-click.stop="toggleConfirm"/>
                            <span style="font-weight: 600; line-height: 1.4;">
                                Saya telah memeriksa &amp; menangani produk ini sesuai prosedur keamanan
                            </span>
                        </label>
                    </div>
                </div>

                <!-- ── Footer Tombol ── -->
                <div style="
                    display: flex;
                    gap: 10px;
                    padding: 0 24px 24px;
                ">
                    <!-- Tombol Batal -->
                    <button
                        t-on-click="cancel"
                        style="
                            flex: 1;
                            padding: 12px;
                            border: 2px solid #bdc3c7;
                            border-radius: 10px;
                            background: white;
                            color: #7f8c8d;
                            font-size: 14px;
                            font-weight: 600;
                            cursor: pointer;
                            transition: all 0.2s;
                        ">
                        ✕ Batal
                    </button>

                    <!-- Tombol Lanjutkan (disabled jika belum confirm) -->
                    <button
                        t-on-click="confirm"
                        t-att-disabled="!canProceed"
                        t-attf-style="
                            flex: 2;
                            padding: 12px;
                            border: none;
                            border-radius: 10px;
                            background: {{ canProceed ? hazardConfig.color : '#bdc3c7' }};
                            color: white;
                            font-size: 14px;
                            font-weight: 700;
                            cursor: {{ canProceed ? 'pointer' : 'not-allowed' }};
                            transition: all 0.3s;
                            box-shadow: {{ canProceed ? '0 4px 12px rgba(0,0,0,0.15)' : 'none' }};
                            opacity: {{ canProceed ? '1' : '0.6' }};
                        ">
                        <t t-if="canProceed">✓ Sudah, Lanjutkan</t>
                        <t t-else="">🔒 Centang konfirmasi dulu</t>
                    </button>
                </div>

            </div>
        </div>
    </t>

</templates>
