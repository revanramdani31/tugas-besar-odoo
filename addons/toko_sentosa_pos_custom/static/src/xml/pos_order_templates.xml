<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="toko_sentosa.PosOrderPatches" t-inherit="point_of_sale.OrderTabs" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('floating-order-container')]" position="inside">
            <div class="sentosa-order-info d-flex align-items-center gap-1 small text-muted ms-2" t-if="order.x_cashier_notes || order.raw?.x_cashier_notes || order.x_barcode_verified || order.raw?.x_barcode_verified">
                <t t-if="order.x_barcode_verified || order.raw?.x_barcode_verified">
                    <span class="badge bg-success">Scan</span>
                </t>
                <t t-if="order.x_cashier_notes || order.raw?.x_cashier_notes">
                    <i class="fa fa-sticky-note me-1"/>
                    <span t-esc="order.x_cashier_notes || order.raw?.x_cashier_notes"/>
                </t>
            </div>
        </xpath>
    </t>

    <t t-name="toko_sentosa.OrderReceiptInherit" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//ReceiptHeader" position="after">
            <div style="font-size: 11px; margin-top: 3px; color: #555; font-style: italic; text-align: center;">
                <span>IG: @tokoutama_sentosa | TikTok: @tokoutama_sentosa</span>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('before-footer')]" position="before">
            <t t-if="order.x_cashier_notes">
                <div class="pos-receipt-text-center" style="margin-top: 10px; margin-bottom: 10px; padding: 5px; border-top: 1px dashed #000; border-bottom: 1px dashed #000; font-size: 11px; text-align: left;">
                    <strong>Catatan Kasir:</strong> <t t-esc="order.x_cashier_notes"/>
                </div>
            </t>
            <div class="pos-receipt-text-center" style="font-size: 10px; margin-top: 15px; margin-bottom: 15px; padding: 8px; border: 1px solid #000; line-height: 1.4; text-align: left;">
                <div style="text-align: center; font-weight: bold; margin-bottom: 4px;">S&amp;K PENGEMBALIAN BARANG</div>
                1. Wajib menyertakan struk fisik asli ini.<br/>
                2. Maksimal penukaran 2 hari setelah tanggal pembelian.<br/>
                3. Barang wajib dalam kondisi utuh (tag/label belum dilepas).<br/>
                4. Produk pakaian dalam atau barang diskon tidak dapat ditukar.
            </div>
        </xpath>
    </t>
</templates>
